                                                                                                                                                    pg_get_functiondef                                                                                                                                                    
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 CREATE OR REPLACE FUNCTION transport.read_binding_assignment(p_execution_id uuid, p_shipment_id uuid)                                                                                                                                                                                                                   +
  RETURNS TABLE(shipment_id uuid, shipment_tenant_id uuid, driver_id uuid, vehicle_id uuid, shipment_version integer, shipment_deleted boolean, driver_status text, execution_id uuid, operating_tenant_id uuid, execution_driver_id uuid, execution_vehicle_id uuid, current_revision_id uuid, revision_version integer)+
  LANGUAGE plpgsql                                                                                                                                                                                                                                                                                                       +
  SECURITY DEFINER                                                                                                                                                                                                                                                                                                       +
  SET search_path TO 'pg_catalog'                                                                                                                                                                                                                                                                                        +
 AS $function$                                                                                                                                                                                                                                                                                                           +
 DECLARE                                                                                                                                                                                                                                                                                                                 +
     v_driver uuid;                                                                                                                                                                                                                                                                                                      +
     v_vehicle uuid;                                                                                                                                                                                                                                                                                                     +
     v_rows integer;                                                                                                                                                                                                                                                                                                     +
 BEGIN                                                                                                                                                                                                                                                                                                                   +
     IF p_execution_id IS NOT NULL THEN                                                                                                                                                                                                                                                                                  +
         PERFORM 1                                                                                                                                                                                                                                                                                                       +
           FROM transport.transport_executions                                                                                                                                                                                                                                                                           +
          WHERE id = p_execution_id                                                                                                                                                                                                                                                                                      +
            FOR SHARE;                                                                                                                                                                                                                                                                                                   +
         IF NOT FOUND THEN                                                                                                                                                                                                                                                                                               +
             RAISE EXCEPTION 'missing execution' USING ERRCODE = 'P0002';                                                                                                                                                                                                                                                +
         END IF;                                                                                                                                                                                                                                                                                                         +
     END IF;                                                                                                                                                                                                                                                                                                             +
                                                                                                                                                                                                                                                                                                                         +
     PERFORM 1                                                                                                                                                                                                                                                                                                           +
       FROM transport.shipments                                                                                                                                                                                                                                                                                          +
      WHERE id = p_shipment_id                                                                                                                                                                                                                                                                                           +
        AND deleted_at IS NULL                                                                                                                                                                                                                                                                                           +
        FOR SHARE;                                                                                                                                                                                                                                                                                                       +
     IF NOT FOUND THEN                                                                                                                                                                                                                                                                                                   +
         RAISE EXCEPTION 'missing shipment' USING ERRCODE = 'P0002';                                                                                                                                                                                                                                                     +
     END IF;                                                                                                                                                                                                                                                                                                             +
                                                                                                                                                                                                                                                                                                                         +
     SELECT s.driver_id, s.vehicle_id                                                                                                                                                                                                                                                                                    +
       INTO v_driver, v_vehicle                                                                                                                                                                                                                                                                                          +
       FROM transport.shipments AS s                                                                                                                                                                                                                                                                                     +
      WHERE s.id = p_shipment_id                                                                                                                                                                                                                                                                                         +
        AND s.deleted_at IS NULL;                                                                                                                                                                                                                                                                                        +
                                                                                                                                                                                                                                                                                                                         +
     IF v_driver IS NOT NULL THEN                                                                                                                                                                                                                                                                                        +
         PERFORM 1                                                                                                                                                                                                                                                                                                       +
           FROM transport.drivers                                                                                                                                                                                                                                                                                        +
          WHERE id = v_driver                                                                                                                                                                                                                                                                                            +
            FOR SHARE;                                                                                                                                                                                                                                                                                                   +
         IF NOT FOUND THEN                                                                                                                                                                                                                                                                                               +
             RAISE EXCEPTION 'missing driver' USING ERRCODE = 'P0002';                                                                                                                                                                                                                                                   +
         END IF;                                                                                                                                                                                                                                                                                                         +
     END IF;                                                                                                                                                                                                                                                                                                             +
                                                                                                                                                                                                                                                                                                                         +
     IF v_vehicle IS NOT NULL THEN                                                                                                                                                                                                                                                                                       +
         PERFORM 1                                                                                                                                                                                                                                                                                                       +
           FROM transport.vehicles                                                                                                                                                                                                                                                                                       +
          WHERE id = v_vehicle                                                                                                                                                                                                                                                                                           +
            FOR SHARE;                                                                                                                                                                                                                                                                                                   +
         IF NOT FOUND THEN                                                                                                                                                                                                                                                                                               +
             RAISE EXCEPTION 'missing vehicle' USING ERRCODE = 'P0002';                                                                                                                                                                                                                                                  +
         END IF;                                                                                                                                                                                                                                                                                                         +
     END IF;                                                                                                                                                                                                                                                                                                             +
                                                                                                                                                                                                                                                                                                                         +
     SELECT count(*)::integer                                                                                                                                                                                                                                                                                            +
       INTO v_rows                                                                                                                                                                                                                                                                                                       +
       FROM transport.shipments AS s                                                                                                                                                                                                                                                                                     +
       LEFT JOIN transport.drivers AS d                                                                                                                                                                                                                                                                                  +
         ON d.id = s.driver_id                                                                                                                                                                                                                                                                                           +
       LEFT JOIN transport.transport_execution_active_shipments AS link                                                                                                                                                                                                                                                  +
         ON link.shipment_tenant_id = s.tenant_id                                                                                                                                                                                                                                                                        +
        AND link.shipment_id = s.id                                                                                                                                                                                                                                                                                      +
       LEFT JOIN transport.transport_executions AS e                                                                                                                                                                                                                                                                     +
         ON e.id = link.execution_id                                                                                                                                                                                                                                                                                     +
       LEFT JOIN transport.transport_execution_revisions AS r                                                                                                                                                                                                                                                            +
         ON r.id = e.current_revision_id                                                                                                                                                                                                                                                                                 +
      WHERE s.id = p_shipment_id                                                                                                                                                                                                                                                                                         +
        AND s.deleted_at IS NULL;                                                                                                                                                                                                                                                                                        +
     IF v_rows > 1 THEN                                                                                                                                                                                                                                                                                                  +
         RAISE EXCEPTION 'ambiguous assignment' USING ERRCODE = '21000';                                                                                                                                                                                                                                                 +
     END IF;                                                                                                                                                                                                                                                                                                             +
                                                                                                                                                                                                                                                                                                                         +
     RETURN QUERY                                                                                                                                                                                                                                                                                                        +
     SELECT s.id, s.tenant_id, s.driver_id, s.vehicle_id, s.version, false,                                                                                                                                                                                                                                              +
            d.status::text,                                                                                                                                                                                                                                                                                              +
            e.id, e.operating_tenant_id, e.driver_id, e.vehicle_id, e.current_revision_id,                                                                                                                                                                                                                               +
            r.version                                                                                                                                                                                                                                                                                                    +
       FROM transport.shipments AS s                                                                                                                                                                                                                                                                                     +
       LEFT JOIN transport.drivers AS d                                                                                                                                                                                                                                                                                  +
         ON d.id = s.driver_id                                                                                                                                                                                                                                                                                           +
       LEFT JOIN transport.transport_execution_active_shipments AS link                                                                                                                                                                                                                                                  +
         ON link.shipment_tenant_id = s.tenant_id                                                                                                                                                                                                                                                                        +
        AND link.shipment_id = s.id                                                                                                                                                                                                                                                                                      +
       LEFT JOIN transport.transport_executions AS e                                                                                                                                                                                                                                                                     +
         ON e.id = link.execution_id                                                                                                                                                                                                                                                                                     +
       LEFT JOIN transport.transport_execution_revisions AS r                                                                                                                                                                                                                                                            +
         ON r.id = e.current_revision_id                                                                                                                                                                                                                                                                                 +
      WHERE s.id = p_shipment_id                                                                                                                                                                                                                                                                                         +
        AND s.deleted_at IS NULL;                                                                                                                                                                                                                                                                                        +
 END;                                                                                                                                                                                                                                                                                                                    +
 $function$                                                                                                                                                                                                                                                                                                              +
 
(1 row)

