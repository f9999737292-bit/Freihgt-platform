# BINTRANS dedicated staging — registry image reference template
#
# Copy relevant lines into protected staging.env after digest verification.
# Do not commit populated digests until operator confirms push from git-b75eb3d build.
#
# Workflow:
#   1. docker pull cr.selcloud.ru/bintrans-staging/<service>:git-b75eb3d
#   2. docker inspect --format='{{index .RepoDigests 0}}' <image>
#   3. Set BINTRANS_<SERVICE>_IMAGE to the FULL reference including registry/repository
#
# REQUIRED digest-pinned format (full reference):
#   cr.selcloud.ru/bintrans-staging/<service>@sha256:<64-hex-chars>
#
# INVALID (preflight rejects):
#   @sha256:abc123...
#   api-gateway@sha256:abc123...   (missing registry)
#   ...@sha256:REPLACE_WITH_VERIFIED_DIGEST

BINTRANS_REGISTRY=cr.selcloud.ru/bintrans-staging
BINTRANS_IMAGE_TAG=git-b75eb3d

# Tag baseline (mutable — replace with digest before runtime deploy):
# BINTRANS_IDENTITY_IMAGE=cr.selcloud.ru/bintrans-staging/identity-service:git-b75eb3d
# BINTRANS_COMPANY_IMAGE=cr.selcloud.ru/bintrans-staging/company-service:git-b75eb3d
# BINTRANS_TRANSPORT_ORDER_IMAGE=cr.selcloud.ru/bintrans-staging/transport-order-service:git-b75eb3d
# BINTRANS_RFX_IMAGE=cr.selcloud.ru/bintrans-staging/rfx-service:git-b75eb3d
# BINTRANS_SHIPMENT_IMAGE=cr.selcloud.ru/bintrans-staging/shipment-service:git-b75eb3d
# BINTRANS_DOCUMENT_IMAGE=cr.selcloud.ru/bintrans-staging/document-service:git-b75eb3d
# BINTRANS_BILLING_REGISTER_IMAGE=cr.selcloud.ru/bintrans-staging/billing-register-service:git-b75eb3d
# BINTRANS_LOW_CODE_IMAGE=cr.selcloud.ru/bintrans-staging/low-code-service:git-b75eb3d
# BINTRANS_CONTROL_TOWER_READ_MODEL_IMAGE=cr.selcloud.ru/bintrans-staging/control-tower-read-model-service:git-b75eb3d
# BINTRANS_API_GATEWAY_IMAGE=cr.selcloud.ru/bintrans-staging/api-gateway:git-b75eb3d

# Digest-pinned example (operator-verified SHA only):
# BINTRANS_API_GATEWAY_IMAGE=cr.selcloud.ru/bintrans-staging/api-gateway@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
