# BINTRANS dedicated staging — registry image reference template
#
# Copy relevant lines into protected staging.env after digest verification.
# Do not commit populated digests to Git.
#
# Workflow:
#   1. Set DEPLOYED_GIT_SHA=<full 40-char SHA> and BINTRANS_IMAGE_TAG=git-<short SHA>
#   2. Build/push images with OCI label org.opencontainers.image.revision=<full SHA>
#   3. docker inspect --format='{{index .RepoDigests 0}}' <image>
#   4. Set BINTRANS_<SERVICE>_IMAGE to FULL digest reference
#
# REQUIRED digest-pinned format:
#   cr.selcloud.ru/bintrans-staging/<service>@sha256:<64-hex-chars>

BINTRANS_REGISTRY=cr.selcloud.ru/bintrans-staging
BINTRANS_IMAGE_TAG=

# Digest-pinned examples (operator-verified SHA only):
# BINTRANS_IDENTITY_IMAGE=cr.selcloud.ru/bintrans-staging/identity-service@sha256:...
# BINTRANS_COMPANY_IMAGE=cr.selcloud.ru/bintrans-staging/company-service@sha256:...
# BINTRANS_TRANSPORT_ORDER_IMAGE=cr.selcloud.ru/bintrans-staging/transport-order-service@sha256:...
# BINTRANS_RFX_IMAGE=cr.selcloud.ru/bintrans-staging/rfx-service@sha256:...
# BINTRANS_SHIPMENT_IMAGE=cr.selcloud.ru/bintrans-staging/shipment-service@sha256:...
# BINTRANS_DOCUMENT_IMAGE=cr.selcloud.ru/bintrans-staging/document-service@sha256:...
# BINTRANS_BILLING_REGISTER_IMAGE=cr.selcloud.ru/bintrans-staging/billing-register-service@sha256:...
# BINTRANS_LOW_CODE_IMAGE=cr.selcloud.ru/bintrans-staging/low-code-service@sha256:...
# BINTRANS_PAYMENT_IMAGE=cr.selcloud.ru/bintrans-staging/payment-service@sha256:...
# BINTRANS_CONTRACT_RATE_IMAGE=cr.selcloud.ru/bintrans-staging/contract-rate-service@sha256:...
# BINTRANS_FREIGHT_COST_IMAGE=cr.selcloud.ru/bintrans-staging/freight-cost-service@sha256:...
# BINTRANS_CONTROL_TOWER_READ_MODEL_IMAGE=cr.selcloud.ru/bintrans-staging/control-tower-read-model-service@sha256:...
# BINTRANS_API_GATEWAY_IMAGE=cr.selcloud.ru/bintrans-staging/api-gateway@sha256:...
