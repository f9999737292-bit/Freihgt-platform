# BINTRANS dedicated Control Tower staging — protected environment template
#
# Copy to (on VM):
#   /protected/bintrans/control-tower-observation/staging.env
# chmod 600. Never commit a populated copy.
#
# IMPORTANT: If a protected env already exists on the VM, do NOT overwrite it
# automatically. Merge manually using the compatibility notes below.
#
# Repository operator checkout: a1c246d
# Runtime image source / tag: b75eb3d / git-b75eb3d
# Migration target: 000019
#
# Canonical observation template (paths differ):
#   scripts/ops/control_tower_shadow_observation/staging.env.example

STAGING_ENVIRONMENT=selectel-staging
DEPLOYED_GIT_SHA=b75eb3d
MIGRATION_TARGET=000019

# BINTRANS dedicated protected paths (override canonical /protected/control-tower-* paths)
COHORT_MANIFEST=/protected/bintrans/control-tower-cohort.json
OBSERVATION_OUTPUT_DIR=/protected/bintrans/control-tower-observation

# PostgreSQL — consumed by compose + backup/migrate scripts
# DATABASE_URL / CONTROL_TOWER_DATABASE_URL are derived in compose overrides
POSTGRES_DB=freight_platform
POSTGRES_USER=bintrans_staging
POSTGRES_PASSWORD=
# POSTGRES_PORT=5432

# Registry (login separately; no tokens in this file)
BINTRANS_REGISTRY=cr.selcloud.ru/bintrans-staging
BINTRANS_IMAGE_TAG=git-b75eb3d

# Loopback-only host bindings (see docker-compose.bintrans-ct-staging.yml)
API_GATEWAY_HOST_PORT=18080
CONTROL_TOWER_READ_MODEL_HOST_PORT=8089
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Observation / gateway (localhost on VM only)
GATEWAY_URL=http://127.0.0.1:18080
PROMETHEUS_URL=http://127.0.0.1:9090

OBSERVATION_MAX_DEAD_LETTER_DELTA=0
OBSERVATION_MAX_GATEWAY_5XX_DELTA=0
OBSERVATION_MAX_RELATIVE_LATENCY_RATIO=1.2
OBSERVATION_SUSTAINED_MISMATCH_MIN=5
OBSERVATION_MAX_CONSUMER_LAG=0
OBSERVATION_REQUIRE_MATCH_RATIO=1.0

# Control Tower shadow safety (PRIMARY MUST REMAIN DISABLED)
CONTROL_TOWER_READ_MODEL_MODE=shadow
CONTROL_TOWER_CONSUMER_ENABLED=true
SHIPMENT_OUTBOX_ENABLED=true
AUTH_ENABLED=true

CONTROL_TOWER_KAFKA_TOPIC=shipment.status.v1
CONTROL_TOWER_KAFKA_GROUP_ID=control-tower-shipment-status-v1

# Runtime auth — required before BINTRANS staging runtime deploy (NOT foundation/migrate).
# Generate a strong unique value; store ONLY in protected staging.env (never commit).
JWT_SECRET=

# JWT_TOKEN — observation/operator tooling only; not required for container startup
JWT_TOKEN=

# Digest-pinned runtime overrides — MUST be full references, e.g.:
# BINTRANS_API_GATEWAY_IMAGE=cr.selcloud.ru/bintrans-staging/api-gateway@sha256:<verified_digest>
# Never use bare @sha256:... without registry/repository prefix.

# Backup gate — set BACKUP_PATH and BACKUP_SHA256 BEFORE BACKUP_VERIFIED=YES
BACKUP_VERIFIED=NO
BACKUP_PATH=
BACKUP_SHA256=

# Cohort gate
COHORT_APPROVED=NO

# Compatibility vs canonical observation template (a1c246d):
# - COHORT_MANIFEST path: /protected/bintrans/... (this template) vs /protected/control-tower-cohort.json (canonical)
# - OBSERVATION_OUTPUT_DIR: /protected/bintrans/... vs /protected/control-tower-observation
# - Adds: POSTGRES_*, BINTRANS_REGISTRY, BINTRANS_IMAGE_TAG, API_GATEWAY_HOST_PORT, BACKUP_*, COHORT_APPROVED, JWT_SECRET
# - Canonical lacks: POSTGRES_*, BINTRANS_*, backup/cohort gate keys (compose uses Makefile defaults if unset)
# - JWT_SECRET: required in protected env for runtime deploy; bintrans compose override externalizes it (no dev default)
# - DATABASE_URL / CONTROL_TOWER_DATABASE_URL: not stored in env file; injected by bintrans compose override from POSTGRES_*
