# BINTRANS dedicated staging — protected environment template
#
# Copy to (on VM):
#   /protected/bintrans/control-tower-observation/staging.env
# chmod 600. Never commit a populated copy.
#
# Release contract:
#   DEPLOYED_GIT_SHA=<full 40-char Git SHA of reviewed release>
#   BINTRANS_IMAGE_TAG=git-<first 7 chars of DEPLOYED_GIT_SHA>  (must match exactly)
#   MIGRATION_TARGET=<6-digit bounded target, e.g. 000064 for current main>
#
# Canonical observation template (paths differ):
#   scripts/ops/control_tower_shadow_observation/staging.env.example

STAGING_ENVIRONMENT=selectel-staging
DEPLOYED_GIT_SHA=
MIGRATION_TARGET=000064

# BINTRANS dedicated protected paths (override canonical /protected/control-tower-* paths)
COHORT_MANIFEST=/protected/bintrans/control-tower-cohort.json
OBSERVATION_OUTPUT_DIR=/protected/bintrans/control-tower-observation

# PostgreSQL — consumed by compose + backup/migrate scripts
POSTGRES_DB=freight_platform
POSTGRES_USER=bintrans_staging
POSTGRES_PASSWORD=

# Registry (login separately; no tokens in this file)
BINTRANS_REGISTRY=cr.selcloud.ru/bintrans-staging
BINTRANS_IMAGE_TAG=

# Service-to-service auth (shared token — required for payment/contract-rate/freight-cost/gateway)
INTERNAL_SERVICE_TOKEN=

# Loopback-only host bindings (see docker-compose.bintrans-ct-staging.yml)
API_GATEWAY_HOST_PORT=18080
CONTROL_TOWER_READ_MODEL_HOST_PORT=8089
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Observation / gateway (localhost on VM only)
GATEWAY_URL=http://127.0.0.1:18080
PROMETHEUS_URL=http://127.0.0.1:9090

OBSERVATION_MAX_DEAD_LETTER_DELTA=0
OBSERVATION_MAX_GATEWAY_5XX_DELTA=0
OBSERVATION_MAX_RELATIVE_LATENCY_RATIO=1.2
OBSERVATION_SUSTAINED_MISMATCH_MIN=5
OBSERVATION_MAX_CONSUMER_LAG=0
OBSERVATION_REQUIRE_MATCH_RATIO=1.0

# Control Tower shadow safety (PRIMARY MUST REMAIN DISABLED)
CONTROL_TOWER_READ_MODEL_MODE=shadow
CONTROL_TOWER_CONSUMER_ENABLED=true
SHIPMENT_OUTBOX_ENABLED=true
AUTH_ENABLED=true

CONTROL_TOWER_KAFKA_TOPIC=shipment.status.v1
CONTROL_TOWER_KAFKA_GROUP_ID=control-tower-shipment-status-v1

# Driver domain events (coexists with shipment.status.v1 consumer)
CONTROL_TOWER_DRIVER_EVENTS_ENABLED=true
CONTROL_TOWER_DRIVER_KAFKA_TOPIC=driver.events.v1
CONTROL_TOWER_DRIVER_KAFKA_GROUP_ID=control-tower-driver-events-v1
CONTROL_TOWER_DRIVER_KAFKA_CLIENT_ID=control-tower-driver-events-consumer
SHIPMENT_KAFKA_DRIVER_TOPIC=driver.events.v1

# Runtime auth — required before BINTRANS staging runtime deploy (NOT foundation/migrate).
JWT_SECRET=

# PostgreSQL connection pool budget (v0.5B6.2 — required for canonical staging runtime).
# 12 DB-using services: 10×DB_MAX_OPEN_CONNS + 2×DB_MAX_OPEN_LIGHT = aggregate 80
# against PostgreSQL effective app capacity 97 (max_connections 100 − superuser_reserved 3).
DB_MAX_OPEN_CONNS=7
DB_MAX_IDLE_CONNS=3
DB_MAX_OPEN_LIGHT=5
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONN_MAX_IDLE_TIME_SECONDS=60

# JWT_TOKEN — observation/operator tooling only; not required for container startup
JWT_TOKEN=

# Digest-pinned runtime overrides — MUST be full references for all 13 application services:
# BINTRANS_IDENTITY_IMAGE=cr.selcloud.ru/bintrans-staging/identity-service@sha256:<verified_digest>
# BINTRANS_PAYMENT_IMAGE=cr.selcloud.ru/bintrans-staging/payment-service@sha256:<verified_digest>
# BINTRANS_CONTRACT_RATE_IMAGE=cr.selcloud.ru/bintrans-staging/contract-rate-service@sha256:<verified_digest>
# BINTRANS_FREIGHT_COST_IMAGE=cr.selcloud.ru/bintrans-staging/freight-cost-service@sha256:<verified_digest>
# ... (see registry.images.template.env)

# Backup gate — set BACKUP_PATH and BACKUP_SHA256 BEFORE BACKUP_VERIFIED=YES
BACKUP_VERIFIED=NO
BACKUP_PATH=
BACKUP_SHA256=

# Cohort gate
COHORT_APPROVED=NO

# VM checkout model (informational — set by operator during release):
# DEPLOY_TOOLING_SHA=<git SHA of operator scripts checkout used for this release>
# RELEASE_SHA must equal DEPLOYED_GIT_SHA above; tooling SHA may differ intentionally.
