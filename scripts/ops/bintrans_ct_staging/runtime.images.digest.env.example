# BINTRANS dedicated staging — digest-pinned runtime image references (protected env template)
#
# Copy verified lines into /protected/bintrans/control-tower-observation/staging.env
# after registry push + digest inspection. Never commit populated digests to Git.
#
# Required format for EACH runtime service:
#   cr.selcloud.ru/bintrans-staging/<service>@sha256:<64-lowercase-hex>
#
# Mutable tag baseline for BUILD/PUSH workflow only (not runtime start):
#   git-b75eb3d

BINTRANS_REGISTRY=cr.selcloud.ru/bintrans-staging
BINTRANS_IMAGE_TAG=git-b75eb3d

# Populate after operator-verified registry digest inspection:
# BINTRANS_IDENTITY_IMAGE=
# BINTRANS_COMPANY_IMAGE=
# BINTRANS_TRANSPORT_ORDER_IMAGE=
# BINTRANS_RFX_IMAGE=
# BINTRANS_SHIPMENT_IMAGE=
# BINTRANS_DOCUMENT_IMAGE=
# BINTRANS_BILLING_REGISTER_IMAGE=
# BINTRANS_LOW_CODE_IMAGE=
# BINTRANS_CONTROL_TOWER_READ_MODEL_IMAGE=
# BINTRANS_API_GATEWAY_IMAGE=
