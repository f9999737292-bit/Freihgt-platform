# Freight Cost Intelligence v2.2 — NON-PRODUCTION pilot environment template
#
# Copy to a protected path on the target host (never commit populated values):
#   /protected/bintrans/freight-cost-pilot/pilot.env
#
# PRODUCTION_MUTATION=NO — do not use on production hosts or production DBs.

PILOT_ENVIRONMENT=local-dev-lab
PILOT_GIT_SHA=37c2eb62ccf9377359eb5c2fdf6f71eb9d187140
MIGRATION_TARGET=000064

# Phase 1 defaults (both OFF)
FREIGHT_COST_ANALYTICS_PROJECTION_ENABLED=false
NUXT_PUBLIC_FREIGHT_COST_WORKSPACE_ENABLED=false

# Phase 2 — enable analytics only after Phase 1 health gate PASS
# FREIGHT_COST_ANALYTICS_PROJECTION_ENABLED=true

# Phase 4 — enable workspace only after API/security/projection gates PASS
# NUXT_PUBLIC_FREIGHT_COST_WORKSPACE_ENABLED=true

# S2S token shared between api-gateway and freight-cost-service (generate per environment)
INTERNAL_SERVICE_TOKEN=

# Optional pilot tenant UUID for rebuild drill (operator-supplied staging data)
# PILOT_TENANT_ID=

# Observability (local lab)
PROMETHEUS_URL=http://127.0.0.1:9090
GRAFANA_URL=http://127.0.0.1:3001
GATEWAY_URL=http://127.0.0.1:8080

# web-procurement (when deployed separately)
# WEB_PROCUREMENT_URL=http://127.0.0.1:3005
