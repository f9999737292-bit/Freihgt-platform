{
  "autopilot_enabled": false,
  "emergency_stop": false,
  "max_parallel_agents": 3,
  "max_launches_per_day": 8,
  "max_retries_cap": 1,
  "max_qa_fix_cycles": 2,
  "budget_max_charged_cents": 0,
  "budget_max_charged_cents_daily": 0,
