# Portable Node.js for local development (optional, created by scripts/setup-node.ps1)
.tools/

# Environment and secrets
.env
.env.*
!.env.example

# Node / frontend build artifacts
node_modules/
.nuxt/
.output/
dist/
coverage/

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Logs and temp files
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Docker local overrides (keep compose files tracked)
docker-compose.override.yml

# Control Tower shadow observation runtime artifacts (never commit)
observation-output/
control-tower-observation/
cohort.json
*.jwt
*.token

# Autopilot local runtime state stays untracked. Do not delete an existing journal or ledger.
tools/bintrans_autopilot/state/*.jsonl
tools/bintrans_autopilot/state/*.lock

# Local emergency-stop marker. Ignored by ordinary add/clean/stash. git clean -fdx still deletes ignored files.
tools/bintrans_autopilot/EMERGENCY_STOP

# Local one-off low-code UI verification scripts (not part of repo deliverable)
scripts/dev/package.json
scripts/dev/verify_lowcode_ui_report.py
scripts/dev/verify_lowcode_ui_temp.mjs
